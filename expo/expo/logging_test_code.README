###  Test code to be used in a Django shell.

def bog_request(object):
    def __call__(*args, **kwargs):
        print len(args), type(args), args
        print len(kwargs), type(kwargs), kwargs
        return object(*args, **kwargs)
    return __call__

@bog_request
def some_func(text, options = [1,2], theme = 'test text'):
    return 'This is some text: '+text, options, theme

some_func('This is a test', options = (1, 2, 3))

